# Copy to .env and fill in. Never commit .env.

# Where the site is published. Add http://localhost:3000 while testing the site locally.
CORS_ORIGINS=https://jjduques.github.io

# n8n webhook that emails you each message (Webhook node, method POST, Header Auth).
# host.docker.internal is the laptop itself, seen from the container.
N8N_WEBHOOK_URL=http://host.docker.internal:5678/webhook/portfolio-contact
# Generate with: openssl rand -hex 32. The same value goes in the n8n Header Auth credential.
N8N_WEBHOOK_TOKEN=

# Messages per hour: per visitor (when Funnel forwards their address) and for everyone together.
RATE_LIMIT_PER_IP=5
RATE_LIMIT_GLOBAL=30

# Messages older than this are deleted.
RETENTION_DAYS=180
